# Persistent Headroom state on the target Docker host.
DATA_DIR=/opt/stacks/headroom
# Keep this aligned with the client-side HEADROOM_PORT setting.
HEADROOM_PORT=8787
HEADROOM_BIND_ADDRESS=127.0.0.1
HEADROOM_IMAGE=ghcr.io/headroomlabs-ai/headroom:code
# Generate a long random value and store it only in Portainer stack variables.
HEADROOM_PROXY_TOKEN=change-me
