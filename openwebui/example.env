# Portainer stack variables. Copy values only into Portainer, never commit a real .env.
# All persistent Open WebUI state must remain under this exact NAS root.
OPEN_WEBUI_DATA_DIR=/mnt/misc/open-webui/data

# Bind Open WebUI only to the approved private address. Do not use 0.0.0.0.
OPEN_WEBUI_BIND_ADDRESS=<private-bind-address>
OPEN_WEBUI_PORT=3000

# Exact approved NAS-local Markdown pilot directory, mounted read-only at /source.
# Example only. Do not index the full vault initially.
OBSIDIAN_PILOT_SOURCE_DIR=/mnt/nextcloud/<user>/files/Apps/Obsidian/<approved-pilot-directory>

# Host-managed oikb config. It contains the post-deployment KB UUID, not a secret.
OIKB_CONFIG_PATH=/mnt/misc/open-webui/sync-state/oikb.yaml

# BWS/Portainer-managed secret FILE paths. Never put secret values in this file or Git.
OPEN_WEBUI_RAG_SYNC_API_KEY_FILE=/run/secrets/open_webui_rag_sync_api_key
OIKB_API_KEY_FILE=/run/secrets/oikb_api_key
