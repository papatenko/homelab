# Persistent host path for Kokoro model files. Set this to durable storage in Portainer.
DATA_DIR=/opt/stacks/kokoro

# Track the current upstream CPU image. Change this in Portainer only to roll back to a tested version.
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest
KOKORO_CONTAINER_NAME=kokoro

# Private listener. Keep loopback by default; only set a separately approved private interface at runtime.
KOKORO_BIND_ADDRESS=127.0.0.1
COMPOSE_PORT_HTTP=8880

# Kokoro-82M fixed voice. This is not a claim of a Russian accent.
KOKORO_DEFAULT_VOICE=am_michael
KOKORO_API_LOG_LEVEL=INFO

# Conservative ceiling for the shared CPU host.
KOKORO_CPU_LIMIT=2.0
KOKORO_CPU_THREADS=2
KOKORO_MEMORY_LIMIT=4g
KOKORO_PIDS_LIMIT=256
