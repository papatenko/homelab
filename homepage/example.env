# Portainer stack variables. Keep real values in Portainer, not Git.
HOMEPAGE_ALLOWED_HOSTS=<HOMEPAGE-LAN-IP>:3000
HOMEPAGE_VAR_RASPI_IP=<RASPBERRY-PI-LAN-IP>
HOMEPAGE_VAR_NAS_IP=<NAS-LAN-IP>
HOMEPAGE_VAR_COOLIFY_IP=<SERVICES-HOST-LAN-IP>
HOMEPAGE_VAR_HERMES_IP=<HERMES-LAN-IP>
HOMEPAGE_VAR_PROXMOX_IP=<PROXMOX-LAN-IP>
HOMEPAGE_VAR_PBS_IP=<PBS-LAN-IP>
HOMEPAGE_VAR_JELLYFIN_IP=<JELLYFIN-LAN-IP>
HOMEPAGE_VAR_OPENWEBUI_IP=<OPENWEBUI-LAN-IP>
# Exception to IP:port-only: Magic Asset is only reachable through its proxy
# hostname. Full URL (scheme + host, no trailing slash); set only in Portainer.
HOMEPAGE_VAR_MAGICASSET_URL=<MAGIC-ASSET-URL>
