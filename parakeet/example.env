# Persistent runtime, binary, and model data. Configure in Portainer.
DATA_DIR=/opt/stacks/parakeet

# NeMo-Speech.cpp CPU release. Upgrade this explicitly after testing.
PARAKEET_RELEASE=0.2.0
PARAKEET_RUNTIME_IMAGE=debian:bookworm-slim
PARAKEET_CONTAINER_NAME=parakeet

# Keep the test endpoint private by default. Assign a private network interface only after approval.
PARAKEET_BIND_ADDRESS=127.0.0.1
COMPOSE_PORT_HTTP=8080

# Conservative pilot limits. One bounded HTTP worker avoids uncontrolled concurrent inference.
PARAKEET_CPU_LIMIT=2.0
PARAKEET_THREADS=1
PARAKEET_MEMORY_LIMIT=2g
PARAKEET_PIDS_LIMIT=256
