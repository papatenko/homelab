# Non-secret runtime configuration template.
# Install outside the repository with owner-only permissions.
# The producer script sets HEARTBEAT_PRODUCER to its distinct identity.
# The coordinator/host administrator must supply actual trusted commands; this
# template intentionally does not invent job or verification command mappings.
HEARTBEAT_COMMAND=
HEARTBEAT_VERIFY=
HEARTBEAT_TIMEOUT=900
# Complete endpoint URLs are injected by the deployment secret/config path.
HEALTHCHECKS_SUCCESS_URL=
HEALTHCHECKS_FAILURE_URL=
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
