# Password for this secondary Pi-hole's web UI / API (also used by nebula-sync).
API_PASSWORD=

# Source of truth that nebula-sync copies FROM (the primary Pi-hole).
# Include scheme and port, e.g. https://<primary-host>:8443
PRIMARY_URL=
PRIMARY_PASSWORD=

# Optional overrides
#TZ=America/Chicago
#PIHOLE_WEB_PORT=8453
#DNS_UPSTREAMS=1.1.1.1;8.8.8.8
#SYNC_CRON=0 * * * *
#DATA_DIR=/opt/stacks/pihole-secondary
# Keep both Pi-hole instances on the same version; pin if the primary is pinned.
#PIHOLE_TAG=latest
#NEBULA_SYNC_TAG=latest
