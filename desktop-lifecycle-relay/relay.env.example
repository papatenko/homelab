# Install as /etc/desktop-lifecycle-relay/relay.env with mode 0600 root:root.
# Source all non-comment values from Bitwarden Secrets Manager or existing root-only key paths.
RELAY_BIND_HOST=<n8n-docker-gateway-address>
RELAY_PORT=8790
RELAY_TOKEN=<bws-injected-random-token>
WOL_MAC=<desktop-mac>
WOL_BROADCAST=<lan-broadcast-address>
WOL_PORT=9
DESKTOP_SSH_HOST=<desktop-host>
DESKTOP_SSH_USER=<automation-user>
DESKTOP_SSH_KEY=/root/.ssh/id_ed25519_services
