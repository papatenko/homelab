[Unit]
Description=Prepare OpenViking VLM secret bind-mount source
Documentation=https://github.com/papatenko/homelab/tree/main/openviking
RequiresMountsFor=/mnt/misc/appdata/openviking/secrets/vlm.env
Before=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/install -d -m 0755 /run/openviking
ExecStart=/usr/bin/test -f /mnt/misc/appdata/openviking/secrets/vlm.env
ExecStart=/usr/bin/chown root:root /mnt/misc/appdata/openviking/secrets/vlm.env
ExecStart=/usr/bin/chmod 0600 /mnt/misc/appdata/openviking/secrets/vlm.env
ExecStart=/usr/bin/ln -sfn /mnt/misc/appdata/openviking/secrets/vlm.env /run/openviking/vlm.env
RemainAfterExit=yes

[Install]
RequiredBy=docker.service
