[Unit]
Description=Refresh read-only Obsidian resources in OpenViking
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/openviking/refresh.env
ExecStart=/usr/local/libexec/openviking-refresh-resources.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
