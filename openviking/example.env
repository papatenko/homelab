# Deployment-specific paths. Set these in Portainer or the host-local environment.
OPENVIKING_BIND_ADDRESS=
OPENVIKING_SERVER_PORT=1933
OPENVIKING_PUBLIC_BASE_URL=
OPENVIKING_DATA_DIR=
OPENVIKING_WIKI_PATH=
OPENVIKING_MOC_PATH=
OPENVIKING_SKILLS_PATH=
OPENVIKING_IMAGE=ghcr.io/volcengine/openviking:latest
OLLAMA_IMAGE=ollama/ollama:latest
# Root-owned BWS-fed VLM key file on the Docker endpoint, mounted read-only.
# It supplies OPENVIKING_VLM_API_KEY only and must never be committed.
OPENVIKING_VLM_SECRETS_FILE=/run/openviking/vlm.env
# Reversible OpenCode Go pilot settings. The API key remains only in the secrets file.
OPENVIKING_VLM_PROVIDER=openai
OPENVIKING_VLM_MODEL=glm-5.3-flash
OPENVIKING_VLM_API_BASE=https://opencode.ai/inference/go/v1
OPENVIKING_VLM_SESSION_ID=openviking-agent-memory
