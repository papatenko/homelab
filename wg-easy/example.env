WG_HOST=
WG_DEFAULT_DNS=
WG_DEFAULT_ADDRESS=
IPV4_ADDRESS=
IPV4_SUBNET=
IPV6_ADDRESS=
# Existing Docker network to adopt. Leave blank to use wg-easy_wg.
WG_NETWORK_NAME=
# bcrypt hash for the admin UI login (required). Generate with:
#   docker run --rm ghcr.io/wg-easy/wg-easy:14 wgpw 'YOUR_PASSWORD'
# Set it as a Portainer stack variable; never commit it.
PASSWORD_HASH=
