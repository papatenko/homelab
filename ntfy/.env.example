# ntfy stack variables (safe placeholders only)
# Keep the bind address on loopback or a private LAN/VPN interface; never use a public interface.
NTFY_BIND_ADDRESS=127.0.0.1
NTFY_PORT=8080
NTFY_DATA_DIR=/opt/stacks/ntfy
NTFY_BASE_URL=http://127.0.0.1:8080
TZ=UTC

# Authentication is explicitly deny-by-default in compose.yaml.
# Do not add credentials here. The coordinator provisions ntfy users at runtime.
