# Persistent model cache and server state. Set the durable NAS path in Portainer.
DATA_DIR=/opt/stacks/faster-whisper-turbo

# CPU-only, side-by-side candidate. Do not reuse Parakeet or existing Whisper names/paths.
FASTER_WHISPER_IMAGE=hwdsl2/whisper-server:latest
FASTER_WHISPER_CONTAINER_NAME=faster-whisper-turbo
FASTER_WHISPER_BIND_ADDRESS=127.0.0.1
COMPOSE_PORT_HTTP=18881

# Accuracy-oriented multilingual Whisper turbo model, CPU INT8.
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=2
WHISPER_LOG_LEVEL=INFO
WHISPER_DISABLE_USAGE_COUNTS=1

# Keep the pilot bounded beside Parakeet and Kokoro.
FASTER_WHISPER_CPU_LIMIT=2.0
FASTER_WHISPER_MEMORY_LIMIT=4g
FASTER_WHISPER_PIDS_LIMIT=256

# Leave empty for the loopback-only pilot. Do not commit a real value.
WHISPER_API_KEY=
