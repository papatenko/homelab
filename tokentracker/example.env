# Stable host path for TokenTracker application state (~/.tokentracker inside the container).
DATA_DIR=/opt/stacks/tokentracker

# Host IP/port to publish. Use 0.0.0.0 for LAN/reverse-proxy access, or 127.0.0.1 for local-only.
BIND_IP=0.0.0.0
COMPOSE_PORT_HTTP=7680

# Optional: pass --no-sync to `tracker serve` (disables the background log-scan
# sync loop). Leave blank to keep syncing enabled.
TOKENTRACKER_SYNC_FLAG=

# Optional: TokenTracker device/access tokens if you want this instance to
# authenticate against the maintainer's cloud (tokentracker.cc / InsForge).
# Not required for local-only usage tracking.
TOKENTRACKER_DEVICE_TOKEN=
TOKENTRACKER_ACCESS_TOKEN=
INSFORGE_BASE_URL=
INSFORGE_ANON_KEY=

# Optional: enables live model pricing sync.
OPENROUTER_API_KEY=

TOKENTRACKER_MEM_LIMIT=384m
