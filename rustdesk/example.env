# Portainer stack variables. Keep real values in Portainer, not Git.
# Relay address handed to clients by hbbs (LAN IP or DNS name, optionally with :21117).
RUSTDESK_RELAY=<relay-host-or-ip>
# Optional overrides
# RUSTDESK_IMAGE=rustdesk/rustdesk-server:1.1.16
# Persistent data (key pair + peer DB) lives outside Portainer's Git checkout.
DATA_DIR=/opt/stacks/rustdesk
