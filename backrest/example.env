# Stable Backrest runtime state on this host
BACKREST_DATA_DIR=/opt/stacks/backrest

# Host path exposed read-only as /userdata
BACKUP_SOURCE_PATH=/

# Host path exposed read-only as /portainer-data.
# Set this to the Portainer data volume/path on hosts that run Portainer.
# On hosts without Portainer, use a readable existing path such as /tmp and
# do not add /portainer-data to that host's backup plan.
PORTAINER_DATA_PATH=/var/lib/docker/volumes/portainer_data/_data

# Use distinct names only when more than one Backrest container runs on one host.
BACKREST_CONTAINER_NAME=backrest
BACKREST_HOSTNAME=backrest

TIMEZONE=America/Chicago
BACKREST_PORT=9898
