# Portainer stack data root for n8n state, PostgreSQL, workflow files, and local backups.
DATA_DIR=/opt/stacks/n8n

N8N_IMAGE=docker.n8n.io/n8nio/n8n:stable
POSTGRES_IMAGE=postgres:16-alpine
N8N_BIND_IP=0.0.0.0
N8N_PORT=5678

# Use HTTP only for direct LAN access. Switch to HTTPS when a reverse proxy terminates TLS.
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

GENERIC_TIMEZONE=America/Chicago

POSTGRES_DB=n8n
POSTGRES_USER=n8n
# Required: set a unique, non-empty password in Portainer. Do not commit it.
POSTGRES_PASSWORD=

# Required: generate once and keep this stable; losing it breaks stored n8n credentials.
N8N_ENCRYPTION_KEY=

# AI Assistant. The sandbox services are enabled by default.
# Configure the model and provider key in the n8n UI. Do not set
# N8N_INSTANCE_AI_MODEL here if you want to change the model in the UI.
N8N_ENABLED_MODULES=instance-ai

# Required sandbox credentials. Set unique values in Portainer, never in Git.
SANDBOX_API_KEYS=
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
SANDBOX_API_RUNNER_API_KEY=
# Must match one value in SANDBOX_API_KEYS.
N8N_INSTANCE_AI_SANDBOX_API_KEY=

# SearXNG is intentionally disabled by default to avoid extra RAM usage.
# Enable it by setting COMPOSE_PROFILES=ai-search and this URL together.
COMPOSE_PROFILES=
SEARXNG_SECRET=
N8N_INSTANCE_AI_SEARXNG_URL=
