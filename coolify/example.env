# Coolify stack variables
#
# The real Coolify environment file must remain on the target host at:
# ${COOLIFY_DATA_DIR}/source/.env
# Do not copy its secret values into this file or into Git.

COOLIFY_DATA_DIR=/data/coolify
COOLIFY_IMAGE=ghcr.io/coollabsio/coolify:4.0.0-beta.462
COOLIFY_POSTGRES_IMAGE=postgres:15-alpine
COOLIFY_REDIS_IMAGE=redis:7-alpine
COOLIFY_REALTIME_IMAGE=ghcr.io/coollabsio/coolify-realtime:1.0.10
COOLIFY_PROXY_IMAGE=traefik:v3.6
COOLIFY_SENTINEL_IMAGE=ghcr.io/coollabsio/sentinel:0.0.22

COOLIFY_APP_PORT=8000
COOLIFY_REALTIME_PORT=6001
COOLIFY_REALTIME_SECURE_PORT=6002
COOLIFY_HTTP_PORT=80
COOLIFY_HTTPS_PORT=443
COOLIFY_PROXY_API_PORT=8080

# These values must match the existing Coolify installation.
DB_USERNAME=replace-with-existing-value
DB_PASSWORD=replace-with-existing-value
DB_DATABASE=coolify
REDIS_PASSWORD=replace-with-existing-value
PUSHER_APP_ID=replace-with-existing-value
PUSHER_APP_KEY=replace-with-existing-value
PUSHER_APP_SECRET=replace-with-existing-value
COOLIFY_SENTINEL_TOKEN=replace-with-existing-value

APP_NAME=Coolify
APP_ENV=production
PHP_MEMORY_LIMIT=256M
PHP_FPM_PM_CONTROL=dynamic
PHP_FPM_PM_START_SERVERS=1
PHP_FPM_PM_MIN_SPARE_SERVERS=1
PHP_FPM_PM_MAX_SPARE_SERVERS=10
SOKETI_DEBUG=false
SOKETI_HOST=0.0.0.0
