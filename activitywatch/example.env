# Portainer stack variables. Keep real values in Portainer, not Git.
# Digest-pinned ghcr.io/graphichealer/aw-server-docker (aw-server v0.13.2, built 2026-04-22).
AW_IMAGE=ghcr.io/graphichealer/aw-server-docker@sha256:a08e08aab689d1ff2dd850d34163a6d6e447d7c2e8ac6ca4beb95da2a49dae52
# Services host Tailscale IP. Do not use 0.0.0.0 or a LAN IP.
AW_BIND_ADDRESS=<Services-Tailscale-IP>
AW_PORT=5600
# Host data directory, must be owned by AW_UID:AW_GID.
AW_DATA_DIR=/opt/stacks/activitywatch/data
AW_UID=1000
AW_GID=1000
