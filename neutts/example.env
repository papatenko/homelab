# Persistent host path for downloaded models and Hugging Face cache.
DATA_DIR=/opt/stacks/neutts

# Docker image name produced by this repository's Dockerfile.
NEUTTS_IMAGE=homelab/neutts-api:1.4.1-cpu

# Container names. Override both only for a temporary side-by-side GitOps migration.
NEUTTS_CONTAINER_NAME=neutts
NEUTTS_AIR_CONTAINER_NAME=neutts-air

# Host port for the OpenAI-compatible speech endpoint.
COMPOSE_PORT_HTTP=8055

# Leave blank only for trusted LAN or VPN access. Set a secret in Portainer
# before exposing the API through a reverse proxy or a wider network.
NEUTTS_API_KEY=

# NeuTTS-2E is an English model with four fixed speakers and emotion control.
NEUTTS_BACKBONE_REPO=neuphonic/neutts-2e-q4-gguf
NEUTTS_CODEC_REPO=neuphonic/neucodec-onnx-decoder-int8
NEUTTS_SPEAKER=emily
NEUTTS_EMOTION=neutral
NEUTTS_MAX_TEXT_CHARS=2000

# Per-container resource ceiling. This isolates speech generation from other apps.
NEUTTS_CPU_LIMIT=2.0
NEUTTS_CPU_THREADS=2
NEUTTS_MEMORY_LIMIT=2g
NEUTTS_PIDS_LIMIT=256

# NeuTTS-Air has separate storage and two independently scoped bearer keys.
# Set both values only in Portainer, never in Git or a local .env file.
NEUTTS_AIR_DATA_DIR=/opt/stacks/neutts-air
NEUTTS_AIR_ADMIN_API_KEY=
NEUTTS_AIR_SYNTHESIS_API_KEY=
NEUTTS_AIR_TMPFS_SIZE=12m
NEUTTS_AIR_IMAGE=homelab/neutts-air-api:1.0.0-cpu
COMPOSE_PORT_AIR_HTTP=8056
NEUTTS_AIR_BACKBONE_REPO=neuphonic/neutts-air
NEUTTS_AIR_CODEC_REPO=neuphonic/neucodec
NEUTTS_AIR_MAX_TEXT_CHARS=2000
NEUTTS_AIR_MAX_REFERENCE_BYTES=10485760
NEUTTS_AIR_MIN_REFERENCE_SECONDS=3
NEUTTS_AIR_MAX_REFERENCE_SECONDS=15
NEUTTS_AIR_CPU_LIMIT=4.0
NEUTTS_AIR_CPU_THREADS=4
NEUTTS_AIR_MEMORY_LIMIT=6g
NEUTTS_AIR_PIDS_LIMIT=512
