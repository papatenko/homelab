# Stable host path for OmniRoute's SQLite database, logs, and backups.
DATA_DIR=/opt/stacks/omniroute

# OmniRoute image. Pin to a specific version tag; avoid floating :latest in Portainer.
OMNIROUTE_IMAGE=diegosouzapw/omniroute:3.8.49

# Host port to publish. Put a reverse proxy in front for HTTPS/remote access.
COMPOSE_PORT_HTTP=20128

# V8 heap ceiling (--max-old-space-size) in MB. Image default is 1024.
# OmniRoute's own docs recommend 8192 for one concurrent coding-agent session
# (Claude Code/Codex/OpenCode /v1/responses traffic) and 10240-12288 for two.
# Bump to 8192 if you see "FATAL ERROR: Reached heap limit" under load.
OMNIROUTE_MEMORY_MB=4096

# JWT signing key for dashboard session tokens. Required.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Encryption key for API keys stored at rest in SQLite. Required.
# Generate: openssl rand -hex 32
API_KEY_SECRET=

# Initial admin dashboard password. Change immediately after first login
# (Dashboard -> Settings -> Security), then rotate this value in Portainer.
INITIAL_PASSWORD=CHANGEME

# Optional: encrypts the entire SQLite database at rest. Leave blank to disable.
# Generate: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=
