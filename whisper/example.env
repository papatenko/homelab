# Stable host path for downloaded Whisper model cache and server state.
DATA_DIR=/opt/stacks/whisper

# Select exactly one profile: cpu or gpu.
# Portainer passes this as the Compose profile selector.
COMPOSE_PROFILES=cpu

# CPU image and GPU image. The GPU image requires Docker Desktop NVIDIA support.
WHISPER_IMAGE=hwdsl2/whisper-server:latest
WHISPER_GPU_IMAGE=hwdsl2/whisper-server:cuda

# Multilingual model. large-v3-turbo is preferred for GPU hosts.
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=2
WHISPER_LOG_LEVEL=INFO
WHISPER_DISABLE_USAGE_COUNTS=1

# Set a real secret in Portainer for remote/VPN access.
# Leave blank only for deliberately trusted private-network access.
WHISPER_API_KEY=

# Host port to publish.
COMPOSE_PORT_HTTP=9000
