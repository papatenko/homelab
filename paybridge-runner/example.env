# Portainer stack data root for the runner's ephemeral work directory.
DATA_DIR=/opt/stacks/paybridge-runner

RUNNER_IMAGE=myoung34/github-runner:latest
RUNNER_NAME=paybridge-runner-services

# Required: a GitHub PAT (classic, repo scope, or fine-grained with
# Administration read/write) on an account that admins momenta-fire/paybridge.
# The container uses it to mint its own short-lived registration token on
# every start/restart. Do not commit a real value.
GH_RUNNER_PAT=
