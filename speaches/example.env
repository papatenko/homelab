# Stable host path for the Hugging Face model cache.
# Set this to a Windows Docker Desktop path in Portainer, for example:
# D:/DockerData/speaches
DATA_DIR=/opt/stacks/speaches

SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cuda-12.6.3
COMPOSE_PORT_HTTP=8000

# Store a real value in Portainer. Keep this blank only for a deliberately
# unauthenticated private-network test.
SPEACHES_API_KEY=

# large-v3-turbo is the preferred multilingual dictation model.
# Speaches' current model registry uses this CTranslate2 model.
PRELOAD_MODELS=["Systran/faster-whisper-medium"]
WHISPER_INFERENCE_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_DEVICE_INDEX=0
STT_MODEL_TTL=1800
LOG_LEVEL=info
ENABLE_UI=false
